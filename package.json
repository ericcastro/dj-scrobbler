{
  "name": "dj-scrobbler",
  "productName": "DJ Scrobbler",
  "version": "0.7.1",
  "description": "Scrobble tracks from DJ sets on YouTube",
  "author": "Eric Castro <errrick@gmail.com>",
  "license": "MIT",
  "main": "main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "prepare:media": "node scripts/prepare-dev-media-tools.js",
    "prestart": "npm run prepare:media",
    "start": "electron .",
    "predev": "npm run prepare:media",
    "dev": "electron . --developer",
    "prepoc:shazam": "npm run prepare:media",
    "poc:shazam": "electron . --developer --shazam-poc",
    "prepoc:shazam:validate": "npm run prepare:media",
    "poc:shazam:validate": "electron . --developer --shazam-validation",
    "poc:next-dj": "node scripts/pocs/next-dj.js",
    "prepoc:cast:hls": "npm run prepare:media",
    "poc:cast:hls": "node scripts/pocs/hls-cast.js",
    "build:airplay": "bash scripts/build-airplay-helper.sh",
    "test": "node --test tests/run-tests.js",
    "pretest:media": "npm run prepare:media",
    "test:media": "node scripts/test-media-runtime.js",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "release": "electron-builder --publish always",
    "check:release": "node scripts/check-release.js"
  },
  "build": {
    "appId": "com.djscrobbler.app",
    "productName": "DJ Scrobbler",
    "copyright": "Copyright © 2025–2026 Eric Castro",
    "directories": {
      "buildResources": "build-resources",
      "output": "dist"
    },
    "files": [
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "main.js",
      "preload.js",
      "lib/**/*",
      "plugins/**/*",
      "renderer/**/*",
      "fonts/**/*",
      "images/**/*",
      "!images/electron-icons/**/*.svg",
      "!images/electron-icons/**/*.iconset",
      "!**/node_modules/.cache/**",
      "!**/*.map"
    ],
    "afterPack": "./scripts/afterPack.js",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "images/electron-icons/neon-night/icon.icns",
      "category": "public.app-category.music",
      "darkModeSupport": true,
      "gatekeeperAssess": false,
      "identity": null,
      "extendInfo": {
        "NSAudioCaptureUsageDescription": "DJ Scrobbler captures audio from its own player for track recognition and TV playback.",
        "NSScreenCaptureUsageDescription": "DJ Scrobbler captures its focus view so the video and overlays can be sent to your TV.",
        "NSLocalNetworkUsageDescription": "DJ Scrobbler discovers and streams to TVs on your local network.",
        "NSBonjourServices": [
          "_googlecast._tcp",
          "_airplay._tcp"
        ]
      }
    },
    "dmg": {
      "title": "DJ Scrobbler ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "images/electron-icons/neon-night/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "images/electron-icons/neon-night/png",
      "category": "Audio"
    },
    "publish": {
      "provider": "github",
      "owner": "ericcastro",
      "repo": "dj-scrobbler",
      "releaseType": "draft"
    }
  },
  "devDependencies": {
    "electron": "^43.8.4",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "electron-updater": "^6.8.11",
    "shazamio-core": "^1.3.1"
  }
}
